{
    "version": 2,
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3",
            "maxDuration": 30
        }
    },
    "routes": [
        { "handle": "filesystem" },
        { "src": "/robots.txt",  "dest": "/api/index.php" },
        { "src": "/sitemap.xml", "dest": "/api/index.php" },
        { "src": "/health",      "dest": "/api/index.php" },
        { "src": "/up",          "dest": "/api/index.php" },
        { "src": "/(.*)",        "dest": "/api/index.php" }
    ]
}
