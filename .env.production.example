# ==============================================================================
# Territorial Army Field Guide - Production environment template
# Copy to .env on the server. NEVER commit a real .env.
# ==============================================================================

APP_NAME="Territorial Army Field Guide"
APP_ENV=production
APP_KEY=                                   # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://www.jointerritorialarmy.com
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# Trust proxies (Vercel, Hetzner nginx, Cloudflare).
TRUSTED_PROXIES=*

# ---------- Logging ----------
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
# Optional: install sentry/sentry-laravel and set this.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---------- Database ----------
#
# Vercel path (Supabase Postgres via the transaction pooler — NOT direct 5432):
#   DB_CONNECTION=pgsql
#   DB_HOST=aws-0-<region>.pooler.supabase.com
#   DB_PORT=6543
#   DB_DATABASE=postgres
#   DB_USERNAME=postgres.<project-ref>
#   DB_PASSWORD=<supabase-db-password>
#   DB_SSLMODE=require
#   DB_CHARSET=utf8
#
# Hetzner path (local MySQL):
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tafieldguide
DB_USERNAME=tafieldguide
DB_PASSWORD=

# ---------- Sessions & cache ----------
# On Hetzner prefer redis; on Vercel use database (sessions table).
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------- Cloudflare R2 (file storage) ----------
FILESYSTEM_DISK=r2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=territorial-army
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=

# ---------- Mail (Resend) ----------
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@jointerritorialarmy.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=

# ---------- SMS (Fast2SMS) ----------
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
FAST2SMS_SENDER_ID=

# ---------- reCAPTCHA (v2 checkbox) ----------
RECAPTCHA_VERSION=v2
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---------- Payments (CCAvenue) ----------
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
CCAVENUE_ENDPOINT=https://secure.ccavenue.com/transaction/transaction.do
CCAVENUE_CURRENCY=INR

# ---------- Filament admin ----------
FILAMENT_DOMAIN=
FILAMENT_PATH=admin

# ---------- Livewire temp uploads ----------
# Keep local so admin PDF/image uploads don't double-trip R2.
LIVEWIRE_TEMPORARY_DISK=local
